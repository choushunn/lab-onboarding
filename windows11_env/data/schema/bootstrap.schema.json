{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "workspace", "paths", "proxy", "system", "path"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workspace": {
      "type": "object",
      "required": ["root", "fallbackRoot", "directories"],
      "properties": {
        "root": { "type": "string" },
        "fallbackRoot": { "type": "string" },
        "directories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "paths": { "type": "object" },
    "proxy": { "type": "object" },
    "ccs": { "type": "object" },
    "system": { "type": "object" },
    "path": { "type": "object" }
  }
}
