{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "provider", "stage", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "provider": {
            "type": "string",
            "enum": ["winget", "exeInstaller", "localInstaller", "fileDownload", "zipDownload", "wheelExtract", "gitClone", "uvPython", "uvTool", "npm", "pacman", "psModule", "vscodeExtension"]
          },
          "stage": { "type": "string", "enum": ["base", "toolchain", "optional", "system", "proxy"] },
          "scope": { "type": "string", "enum": ["machine", "user"] },
          "required": { "type": "boolean" },
          "packageId": { "type": "string" },
          "file": { "type": "string" },
          "registryName": { "type": "string" },
          "verifyPaths": { "type": "array", "items": { "type": "string" } },
          "version": { "type": "string" },
          "condition": { "type": "string", "enum": ["nvidiaGpu"] },
          "urls": { "type": "array", "items": { "type": "string" } },
          "target": { "type": "string" },
          "repo": { "type": "string" },
          "bootstrap": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
