{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "pip", "uv", "npm", "winget", "cargo", "rustup", "go", "maven", "gradle", "nuget", "msys2"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "winget": {
      "type": "object",
      "required": ["sourceName", "sources"],
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^https://" }
        },
        "official": { "type": "string" }
      }
    }
  }
}
