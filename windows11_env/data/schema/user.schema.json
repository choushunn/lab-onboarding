{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["gitName", "gitEmail", "writeAiConfig", "aiProvider", "aiModel", "ccsRoutePort"],
  "properties": {
    "gitName": { "type": "string" },
    "gitEmail": { "type": "string" },
    "writeAiConfig": { "type": "boolean" },
    "aiProvider": { "type": "string" },
    "aiModel": { "type": "string" },
    "ccsRoutePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
